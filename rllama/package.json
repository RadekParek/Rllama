{
  "name": "rllama",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Rllama - a multi-provider AI workspace for desktop and Android",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "desktop": "npm run build && electron .",
    "desktop:pack": "npm run build && electron-builder --dir",
    "desktop:dist": "npm run build && electron-builder",
    "android:sync": "npm run build && cap sync android",
    "android:build": "npm run build && cap sync android && cd android && ./gradlew assembleDebug",
    "icons": "python3 scripts/make-icons.py",
    "logos": "node scripts/make-logos.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/core": "^7.6.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "simple-icons": "^16.36.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.10",
    "@lobehub/icons-static-svg": "^1.101.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^3.2.7"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "app.rllama",
    "productName": "Rllama",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "release"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/icon.png",
      "category": "Development"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.png"
    }
  }
}
